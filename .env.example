# Copy this file to `.env` and adjust as needed. `docker compose up` (dev)
# works with none of these set at all — they only override the defaults
# baked into docker-compose.yml. `docker compose -f docker-compose.prod.yml up`
# (production) requires POSTGRES_PASSWORD and BASE_DOMAIN to be set for real.

# Postgres credentials used by both the `postgres` and `app` containers.
POSTGRES_USER=pmtool
POSTGRES_PASSWORD=pmtool
PLATFORM_DB_NAME=pmtool_platform

# Base domain tenants are served under as <subdomain>.<BASE_DOMAIN>, and the
# platform-admin UI as admin.<BASE_DOMAIN>. Local dev defaults to "localhost"
# (e.g. demo.localhost, admin.localhost) without needing this set.
BASE_DOMAIN=localhost

# Host port Caddy binds to in dev (docker-compose.yml only) — change if 80 is
# already taken on your machine.
CADDY_HTTP_PORT=80

# Directory (inside the app container) uploaded files are written to. The
# compose files already set this to /app/uploads; only needed here if you run
# `npm run dev` directly on the host instead of through Docker.
UPLOADS_DIR=./uploads
