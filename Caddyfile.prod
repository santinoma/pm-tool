{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://app:3000/api/platform/tls-ask
		interval 5m
		burst 5
	}
}

# Catch-all: matches any hostname pointed at this server (the apex domain, admin.<domain>,
# and every tenant subdomain) and gets its certificate issued on first request via on_demand_tls
# — the /api/platform/tls-ask endpoint decides which hostnames are actually allowed a cert.
https:// {
	tls {
		on_demand
	}

	@admin host admin.{$BASE_DOMAIN}
	basic_auth @admin {
		# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
		# then put the resulting hash (starting with $2a$) into ADMIN_PASSWORD_HASH in .env.
		admin {$ADMIN_PASSWORD_HASH}
	}

	reverse_proxy app:3000
}
