{
  "name": "pm-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:platform:generate": "prisma generate --config prisma.platform.config.ts",
    "db:platform:migrate": "prisma migrate dev --config prisma.platform.config.ts",
    "db:tenant:generate": "prisma generate --config prisma.tenant.config.ts",
    "db:tenant:migrate": "prisma migrate dev --config prisma.tenant.config.ts",
    "postinstall": "npm run db:platform:generate && npm run db:tenant:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "isomorphic-dompurify": "^3.23.0",
    "marked": "^18.0.11",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "7.10.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
