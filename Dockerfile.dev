FROM node:22-alpine
WORKDIR /app

# Nur für `prisma generate` in postinstall (introspiziert das Schema, verbindet sich nicht wirklich) —
# die echten Werte kommen zur Laufzeit über docker-compose's env_file/environment.
ENV PLATFORM_DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder
ENV TENANT_DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder

COPY . .
RUN npm install

EXPOSE 3000
CMD ["npm", "run", "dev"]
